---
import Brand from './Brand.astro';
import { experienceLinks, audienceLinks, resourceLinks } from '../data/site';
---
<header class="site-header" data-header>
  <div class="header-inner">
    <div class="av-header-brand"><Brand variant="light" compact={true} /></div>
    <nav class="desktop-nav" aria-label="Primary">
      <a href="/">Home</a>
      <a href="/about/">About Us</a>
      <div class="nav-item has-menu">
        <a href="/experiences/">Destinations</a>
        <div class="mega-menu">
          {experienceLinks.map((item)=><a href={item.href}>{item.label}</a>)}
        </div>
      </div>
      <div class="nav-item has-menu">
        <a href="/services/">Pages</a>
        <div class="mega-menu mega-menu--wide">
          <div><p class="mega-label">Travel planning</p><a href="/services/">Our Services</a><a href="/how-it-works/">How It Works</a><a href="/why-talon/">Why Choose Us</a><a href="/join-a-trip/">Tour Packages</a></div>
          <div><p class="mega-label">For groups</p>{audienceLinks.slice(0,4).map((item)=><a href={item.href}>{item.label}</a>)}</div>
          <div><p class="mega-label">Explore</p><a href="/trip-leaders-partners/">Trip Leaders & Partners</a><a href="/gallery/">Gallery</a><a href="/faq/">FAQ</a>{resourceLinks.slice(0,2).map((item)=><a href={item.href}>{item.label}</a>)}</div>
        </div>
      </div>
      <a href="/contact/">Contact Us</a>
    </nav>
    <div class="header-actions">
      <a class="av-header-tool" href="/resources/" aria-label="Search travel resources">⌕</a>
      <a class="av-header-tool" href="/experiences/" aria-label="Browse site sections"><span class="av-grid-icon" aria-hidden="true">{Array.from({length:9}).map(()=><i></i>)}</span></a>
      <a class="button button-small" href="/plan-a-trip/">Get in Touch</a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle><span></span><span></span></button>
  </div>
  <div class="mobile-panel" data-mobile-panel>
    <a href="/">Home</a><a href="/about/">About Us</a><a href="/experiences/">Destinations</a><a href="/private-group-travel/">Private Group Travel</a><a href="/join-a-trip/">Tour Packages</a><a href="/services/">Our Services</a><a href="/why-talon/">Why Choose Us</a><a href="/resources/">Travel Tips</a><a href="/faq/">FAQ</a><a href="/contact/">Contact Us</a><a class="button" href="/plan-a-trip/">Get in Touch</a>
  </div>
</header>
<script>
  const toggle=document.querySelector('[data-menu-toggle]');
  const panel=document.querySelector('[data-mobile-panel]');
  toggle?.addEventListener('click',()=>{
    const open=toggle.getAttribute('aria-expanded')==='true';
    toggle.setAttribute('aria-expanded',String(!open));
    panel?.toggleAttribute('data-open',!open);
  });
</script>
