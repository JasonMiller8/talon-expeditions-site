---
interface Props { variant?: 'light' | 'dark'; compact?: boolean }
const { compact=false } = Astro.props;
---
<a class:list={['brand-logo', compact && 'brand-logo--compact']} href="/" aria-label="Talon Expeditions home">
  <img src="/assets/talon-expeditions-logo-light.png" alt="Talon Expeditions" width="900" height="267" />
</a>
<style>
  .brand-logo{display:inline-flex;align-items:center;text-decoration:none;width:min(245px,28vw)}
  .brand-logo img{display:block;width:100%;height:auto}
  .brand-logo--compact{width:min(210px,28vw)}
  @media(max-width:680px){.brand-logo{width:190px}.brand-logo--compact{width:170px}}
</style>
