---
import Brand from './Brand.astro';
---
<footer class="footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <Brand />
      <p>Fully supported group travel for active, cultural, and experience-led journeys around the world.</p>
      <p class="legal">Talon Global LLC dba Talon Expeditions</p>
    </div>
    <div>
      <h2>Travel</h2>
      <a href="/private-group-travel/">Private Group Travel</a>
      <a href="/learn-to-trips/">Learn-To Trips</a>
      <a href="/trekking-active-travel/">Trekking & Active</a>
      <a href="/cultural-cruise-travel/">Cultural & Cruise</a>
    </div>
    <div>
      <h2>Company</h2>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="mailto:sales@talonexpeditions.com">sales@talonexpeditions.com</a>
    </div>
    <div class="footer-cta">
      <p class="eyebrow">Have a group in mind?</p>
      <h2>Start with the trip you want to create.</h2>
      <a class="button" href="/contact/">Plan with Talon</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Talon Expeditions</span>
    <span>U.S.-based planning. Worldwide travel.</span>
  </div>
</footer>
