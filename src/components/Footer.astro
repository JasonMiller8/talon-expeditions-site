---
import Brand from './Brand.astro';
import { business } from '../data/site';
---
<footer class="footer">
  <div class="av-footer-grid shell">
    <div class="av-footer-brand">
      <Brand variant="light" />
      <p>Talon Expeditions plans supported group travel, active journeys, learn-to trips, cultural programs, cruises, and custom itineraries for people who want more than a generic package.</p>
      <div class="av-footer-social" aria-label="Social links"><span>◉</span><span>●</span><span>▶</span><span>◆</span></div>
    </div>
    <div class="av-footer-col">
      <h3>Quick Links</h3>
      <a href="/about/">About Us</a><a href="/experiences/">Destinations</a><a href="/join-a-trip/">Tour Packages</a><a href="/services/">Our Services</a><a href="/how-it-works/">How It Works</a><a href="/resources/">Blog</a><a href="/contact/">Contact Us</a>
    </div>
    <div class="av-footer-col">
      <h3>Top Experiences</h3>
      <a href="/private-group-travel/">Private Group Travel</a><a href="/learn-to-trips/">Learn-To Trips</a><a href="/trekking-active-travel/">Trekking & Active Travel</a><a href="/cultural-cruise-travel/">Culture & Cruise</a><a href="/group-travel/">Clubs & Communities</a><a href="/gallery/">Experience Gallery</a>
    </div>
    <div class="av-footer-col">
      <h3>Contact Information</h3>
      <div class="av-contact-row"><div class="av-contact-icon">⌕</div><div><small>Phone Number</small><a href={`tel:${business.phoneHref}`}>{business.phone}</a></div></div>
      <div class="av-contact-row"><div class="av-contact-icon">✉</div><div><small>Email Address</small><a href={`mailto:${business.email}`}>{business.email}</a></div></div>
      <div class="av-contact-row"><div class="av-contact-icon">⌖</div><div><small>U.S. Office</small><strong>{business.address.street}<br/>{business.address.city}, {business.address.region} {business.address.postalCode}</strong></div></div>
    </div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {business.legalName}. All Rights Reserved.</span><span><a href="/privacy/">Privacy Policy</a> &nbsp; · &nbsp; <a href="/terms/">Terms & Conditions</a></span></div>
</footer>
