---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlanningCTA from '../components/PlanningCTA.astro';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Trip Examples',href:'/trip-examples/'}];
const examples=[
  {type:'Hiking club',title:'A supported multi-day trekking program',image:images.trekking,summary:'A club already knows it wants a mountain trip, but members vary in pace, comfort expectations, and international travel experience.',detail:'The planning work centers on selecting a route with the right difficulty, building realistic daily distances, matching lodging to the group, arranging luggage or transfer support where useful, clarifying equipment and fitness expectations, and creating enough contingency time that weather or travel delays do not immediately unravel the itinerary.',links:[['Supported Trekking','/trekking-active-travel/supported-trekking/'],['Hiking Clubs','/group-travel/hiking-clubs/']]},
  {type:'Dive community',title:'A learn-to scuba trip for beginners',image:images.water,summary:'A dive community wants to introduce new members to the sport without making travelers coordinate a course, resort, transfers, equipment, and destination logistics separately.',detail:'The trip is designed around the training progression first. Accommodation, transfer timing, rest, equipment fitting, water sessions, certification requirements, and non-diving destination time are then built around the instructional schedule. Experienced companions can be accommodated where the local operator and itinerary support different experience levels.',links:[['Learn to Scuba','/learn-to-trips/scuba-diving/'],['Dive Communities','/group-travel/dive-communities/']]},
  {type:'Wellness community',title:'An active-rest trip with movement and culture',image:images.lake,summary:'A studio or wellness community wants a shared trip that feels purposeful without turning every day into a high-performance activity program.',detail:'The itinerary might combine morning movement sessions, moderate hikes or paddling, local food and cultural experiences, recovery time, and comfortable lodging. The planning question is less about maximizing activities and more about creating a rhythm that feels good for the group while still giving travelers a reason to have joined this particular departure.',links:[['Wellness Groups','/group-travel/wellness-yoga/'],['Beginner Active Trips','/trekking-active-travel/beginner-active-trips/']]},
  {type:'Business or team',title:'A team journey with a real destination purpose',image:images.city,summary:'A business wants time together outside the office, but does not want a generic meeting package or an itinerary filled with forced team-building exercises.',detail:'The trip can use travel itself as the shared structure: a destination with a manageable active component, strong meals, cultural time, optional work sessions, and enough unscheduled space for genuine conversation. Travel origins, rooming, transfer timing, expense expectations, and the balance between required and optional activities are made clear before the group arrives.',links:[['Business & Teams','/group-travel/businesses-teams/'],['Custom Planning','/custom-group-trip-planning/']]},
  {type:'Social or affinity group',title:'A hosted culture-and-cruise program',image:images.boat,summary:'An organizer has an audience that wants to travel together but prefers comfort, social connection, and a structured experience over a demanding active itinerary.',detail:'A cruise or cultural land program can provide the core route while Talon helps shape pre- and post-trip nights, group dining, local experiences, arrival coordination, optional activity blocks, and the information participants need before departure. The result is more cohesive than simply asking everyone to book the same cruise independently.',links:[['Hosted Cruises','/cultural-cruise-travel/hosted-cruises/'],['Social Groups','/group-travel/social-affinity/']]},
  {type:'Private group',title:'A first active trip for mixed-experience friends',image:images.coast,summary:'A private group wants something more active than a conventional vacation, but several travelers are new to multi-day outdoor travel.',detail:'The trip can be built around shorter active days, clear difficulty descriptions, comfortable evenings, optional extensions, and simple preparation. Nobody needs to pretend the group is an expedition team. The objective is to create enough challenge and movement to feel distinct while keeping the trip realistic for the people who are actually going.',links:[['Private Groups','/private-group-travel/'],['Active Travel','/trekking-active-travel/']]}
];
---
<BaseLayout title="Group Trip Planning Examples | Talon Expeditions" description="Representative group trip planning examples for hiking clubs, dive communities, wellness groups, teams, social groups, and private travelers considering supported travel with Talon Expeditions." image={images.trekking} breadcrumbs={breadcrumbs}>
  <section class="page-hero" style={`background-image:url('${images.trekking}')`}><div class="shell"><Breadcrumbs items={breadcrumbs}/><p class="eyebrow">Trip planning examples</p><h1 class="section-title">See how the planning model changes with the group.</h1><p>These examples show how Talon Expeditions approaches different kinds of group travel. They are representative planning scenarios rather than advertised departures, and they are designed to make the service easier to understand before a real itinerary is developed.</p></div></section>

  <section class="section"><div class="shell definition-grid"><div class="definition-sticky"><p class="eyebrow">How to read these examples</p><h2>The useful part is the planning logic, not a copied itinerary.</h2></div><div class="definition-body"><div class="answer-panel"><h2>What does a custom group trip look like?</h2><p>A custom group trip starts with the people, purpose, timing, activity level, and practical constraints of the group. Two organizations visiting the same destination can need very different itineraries because their travelers, support expectations, budgets, and reasons for going are different.</p></div><p>That is why Talon does not treat every private group as a request for a standard tour with a new departure date. The group model affects transport, lodging, activity selection, guide or instructor requirements, rooming, contingency planning, communication, and how much preparation travelers need before departure.</p><p>The examples below illustrate those differences. They are intentionally specific enough to be useful while avoiding claims about departures, suppliers, or historical trips that are not being represented as confirmed public inventory.</p></div></div></section>

  <section class="section soft-section"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">Six group scenarios</p><h2 class="section-title">Different groups create different planning problems.</h2></div><p class="section-copy">A large operator should be able to explain how the work changes, not just show a wall of destination photos. These examples focus on the decisions that actually shape the trip.</p></div><div class="story-grid">{examples.map((item,index)=><article class="story-card"><div class="story-image" style={`background-image:url('${item.image}')`}></div><div class="story-body"><span class="story-type">{item.type}</span><h3>{item.title}</h3><p class="story-summary">{item.summary}</p><p>{item.detail}</p><div class="story-links">{item.links.map(([label,href])=><a href={href}>{label} →</a>)}</div><span class="story-number">{String(index+1).padStart(2,'0')}</span></div></article>)}</div></div></section>

  <section class="section"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">What stays consistent</p><h2 class="section-title">The itinerary changes. The planning discipline does not.</h2></div><p class="section-copy">Whatever the trip style, the same core questions have to be answered clearly before travelers should be asked to commit.</p></div><div class="why-grid"><div class="why-item"><span class="number">01</span><h3>Who is traveling?</h3><p>Group size, experience, activity level, rooming, origin cities, budget sensitivity, and why these people want to travel together.</p></div><div class="why-item"><span class="number">02</span><h3>What is the trip for?</h3><p>A route, a skill, a social program, a club objective, a team experience, or simply a more active way to see a place.</p></div><div class="why-item"><span class="number">03</span><h3>What needs support?</h3><p>Travel bookings, local operators, transfers, participant communication, readiness, equipment, hosting, or some combination of those pieces.</p></div><div class="why-item"><span class="number">04</span><h3>What has to be clear?</h3><p>Price assumptions, inclusions, difficulty, deadlines, responsibilities, cancellation terms, and what travelers need to do next.</p></div></div></div></section>

  <section class="feature-band" style={`background-image:url('${images.planning}')`}><div class="shell"><div class="band-copy"><p class="eyebrow">Build from the real group</p><h2 class="section-title">A good planning example becomes useful when your constraints replace the assumptions.</h2><p>Bring us the actual group, likely dates, destination ideas, activity interests, budget range, or simply the kind of experience you want people to have. We can use that information to determine what kind of trip structure is realistic.</p><a class="button" href="/plan-a-trip/">Start a Planning Inquiry</a></div></div></section>
  <PlanningCTA title="Have a trip in mind that does not fit one of these examples?" copy="That is exactly what custom planning is for. Start with the group and the outcome, then build the itinerary around them." />
</BaseLayout>
