---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { articles, resourceCategories } from '../../data/articles';
export function getStaticPaths(){ return resourceCategories.map((category)=>({params:{slug:category.slug},props:{category}})); }
const { category }=Astro.props; const matching=articles.filter((article)=>article.categorySlug===category.slug);
const breadcrumbs=[{label:'Resources',href:'/resources/'},{label:category.title,href:Astro.url.pathname}];
---
<BaseLayout title={`${category.title} Resources | Talon Expeditions`} description={category.description} image={category.image} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${category.image}')`}><div class="shell"><h1>{category.title}</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-resource-category-head"><div><p class="eyebrow">Travel Tips & Guides</p><h2>Practical Answers for {category.title}</h2></div><p>{category.description} Each article answers a specific question first, then explains the decisions, constraints, and next steps that matter when the advice is applied to a real trip.</p></div><div class="av-blog-grid">{matching.length?matching.map((article)=><a class="av-blog-card" href={`/guides/${article.slug}/`}><div class="av-blog-image" style={`background-image:url('${article.image}')`}></div><div class="av-blog-body"><span class="av-blog-meta">{article.category}</span><h3>{article.title}</h3><p>{article.description}</p><span class="text-arrow">Read More →</span></div></a>):<div class="av-service-card"><h3>More guides are being added</h3><p>This topic remains part of the permanent Talon Expeditions planning library. Additional question-led guides will appear here as the resource base grows.</p></div>}</div></div></section>
  <section class="section" style="background:var(--av-soft)"><div class="shell"><div class="av-resource-category-head"><div><p class="eyebrow">Related Topics</p><h2>Keep Following the Planning Question</h2></div><p>Group travel questions overlap. Preparation affects itinerary fit, itinerary fit affects group size, and group size affects transport, lodging, activities, and cost.</p></div><div class="av-resource-category-grid">{resourceCategories.filter(item=>item.slug!==category.slug).map((item)=><a class="av-resource-category-card" href={`/resources/${item.slug}/`}><h3>{item.title}</h3><p>{item.description}</p><span>Explore this topic →</span></a>)}</div></div></section>
</BaseLayout>
