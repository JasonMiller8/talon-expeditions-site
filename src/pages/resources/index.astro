---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { articles, resourceCategories } from '../../data/articles';
import { images } from '../../data/assets';
const breadcrumbs=[{label:'Travel Tips & Guides',href:'/resources/'}];
---
<BaseLayout title="Group Travel Resources & Planning Guides | Talon Expeditions" description="Practical group travel planning guides, trip preparation resources, learn-to travel advice, trekking guidance, organizer resources, and cultural travel planning from Talon Expeditions." image={images.packing} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.packing}')`}><div class="shell"><h1>Blog & Travel Tips</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-blog-heading"><p class="eyebrow">Travel Tips & Stories</p><h2>Latest Stories, Planning Guides & Travel Inspiration</h2><p>Practical guidance for organizers and travelers making decisions about group size, activity level, preparation, support, booking structure, and the work behind a better group journey.</p></div><div class="av-blog-grid">{articles.slice(0,9).map((article)=><a class="av-blog-card" href={`/guides/${article.slug}/`}><div class="av-blog-image" style={`background-image:url('${article.image}')`}></div><div class="av-blog-body"><span class="av-blog-meta">{article.category}</span><h3>{article.title}</h3><p>{article.description}</p><span class="text-arrow">Read More →</span></div></a>)}</div></div></section>
  <section class="section" style="background:var(--av-soft)"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Explore by Topic</p><h2>Planning Knowledge Organized Around Real Questions</h2></div><p>The topic hubs connect longer guides with the commercial pages they support so a traveler can move naturally from research to planning.</p><a class="button button-small" href="/faq/">Browse FAQs</a></div><div class="av-service-grid">{resourceCategories.map((category)=><a class="av-service-card" href={`/resources/${category.slug}/`} style="text-decoration:none"><div class="av-service-card-icon">↗</div><h3>{category.title}</h3><p>{category.description}</p><span class="text-arrow">Explore Resources →</span></a>)}</div></div></section>
  <section class="av-newsletter-hero" style={`background-image:url('${images.coast}')`}><div class="shell av-newsletter-grid"><div class="av-newsletter-card"><p class="eyebrow">Keep Exploring</p><h2>Start with a question. Move toward a real plan.</h2><p>The library is built to answer practical questions directly, explain the tradeoffs, and connect those answers to the trip formats where they matter.</p><a class="button button-small" href="/plan-a-trip/">Plan a Trip</a></div><div class="av-stat-row"><div class="av-stat"><strong>{articles.length}</strong><span>Long-form guides</span></div><div class="av-stat"><strong>{resourceCategories.length}</strong><span>Planning topics</span></div><div class="av-stat"><strong>1</strong><span>Connected planning library</span></div></div></div></section>
</BaseLayout>
