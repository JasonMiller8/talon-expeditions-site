---
import BaseLayout from '../layouts/BaseLayout.astro';
import { images } from '../data/assets';
const experiences = [
  { title:'Private Group Travel', kicker:'Built around your people', copy:'Custom journeys for clubs, communities, teams, studios, friends, and organizer-led groups.', image:images.group, href:'/private-group-travel/', tags:['Custom','Group-first'] },
  { title:'Trekking & Active Travel', kicker:'Move through the place', copy:'Hiking, multi-day trekking, mountain journeys, and active itineraries with preparation built in.', image:images.trekking, href:'/trekking-active-travel/', tags:['Trekking','Active'] },
  { title:'Learn-To Trips', kicker:'Travel with progression', copy:'Build a journey around learning to dive, surf, sail, ski, climb, or develop outdoor skills.', image:images.surf, href:'/learn-to-trips/', tags:['Skills','Beginner-ready'] },
  { title:'Culture & Cruise', kicker:'Discover at the right pace', copy:'Hosted cultural journeys, coastlines, cruises, food, heritage, and active discovery without over-programming.', image:images.culture, href:'/cultural-cruise-travel/', tags:['Culture','Cruise'] },
  { title:'Wildlife & Nature', kicker:'Go for what lives there', copy:'Nature-led journeys where wildlife, landscape, and conservation context are central to the experience.', image:images.wildlife, href:'/contact/', tags:['Nature','Wildlife'] },
  { title:'Wellness & Active Rest', kicker:'Move, reset, reconnect', copy:'Travel for groups that want a balance of movement, restoration, shared experiences, and genuine time away.', image:images.lake, href:'/contact/', tags:['Wellness','Active rest'] }
];
---
<BaseLayout title="Travel Experiences | Talon Expeditions" description="Explore private group travel, trekking, learn-to trips, cultural journeys, cruises, wildlife travel and active-rest experiences with Talon Expeditions." image={images.train}>
  <section class="page-hero" style={`background-image:url('${images.train}')`}><div class="shell"><p class="eyebrow">Experiences</p><h1 class="section-title">Start with what you want the group to experience.</h1><p>Destinations matter, but they are only one part of the trip. Choose the kind of journey first and Talon can shape the place, pace, logistics, and support around it.</p></div></section>
  <section class="specialty-intro"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">Choose your direction</p><h2 class="section-title">Travel styles with a reason to go.</h2></div><p class="section-copy">Fewer generic packages, more clear ways for a group to decide what kind of trip fits them.</p></div><div class="destination-grid">{experiences.map((item)=><a class="destination-card" href={item.href} style={`background-image:url('${item.image}')`}><div class="destination-content"><span class="tagline">{item.kicker}</span><h3>{item.title}</h3><p>{item.copy}</p><div class="mini-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></div></a>)}</div></div></section>
  <section class="feature-band section" style={`background-image:url('${images.galleryTravel}')`}><div class="shell"><div class="band-copy"><p class="eyebrow">Not a mass-market tour catalog</p><h2 class="section-title">The right trip starts with fit, not inventory.</h2><p>For private groups, we do not need to force you into a prebuilt departure. We can use your people, goals, ability level, timing, and desired support to define the journey first.</p><a class="button" href="/private-group-travel/">See Private Group Travel</a></div></div></section>
  <section class="section"><div class="shell process-donor"><div class="process-visual" style={`background-image:url('${images.planning}')`}><div class="process-callout"><h3>Start with the idea.</h3><p>You do not need a finished destination or itinerary to begin.</p></div></div><div><p class="eyebrow">How Talon shapes it</p><h2 class="section-title">A few clear steps from “what if?” to a trip your group can join.</h2><div class="process-list"><div class="process-item"><b>Define the experience</b><p>What should people do, learn, feel, or accomplish?</p></div><div class="process-item"><b>Match the group</b><p>Ability, comfort, age mix, interests, timing, and realistic pace.</p></div><div class="process-item"><b>Build the travel</b><p>Destination, lodging, transport, operators, activities, and support.</p></div><div class="process-item"><b>Prepare the people</b><p>Clear expectations, readiness, communications, and next steps.</p></div></div><a class="button" href="/contact/">Start Planning</a></div></div></section>
</BaseLayout>
