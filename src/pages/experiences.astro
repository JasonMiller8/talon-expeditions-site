---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { images } from '../data/assets';
import { coreExperienceCards } from '../data/site';
const breadcrumbs=[{label:'Destinations & Experiences',href:'/experiences/'}];
const additional=[
  {title:'Wildlife & Nature',image:images.wildlife,copy:'Nature-led journeys where landscapes, wildlife, and local environments are central to the itinerary.',href:'/custom-group-trip-planning/',tags:['Nature','Wildlife','Private groups']},
  {title:'Water & Island Travel',image:images.water,copy:'Diving, snorkeling, sailing, paddling, island travel, and coastal itineraries built around time in and around the water.',href:'/group-travel/dive-communities/',tags:['Water','Islands','Active']},
  {title:'Wellness & Active Rest',image:images.lake,copy:'Movement, recovery, culture, nature, and time together without turning every day into a performance objective.',href:'/group-travel/wellness-yoga/',tags:['Wellness','Active rest','Groups']}
];
const cards=[...coreExperienceCards.slice(0,3).map((item)=>({...item,tags:['Private groups','Supported','Worldwide']})),...additional];
---
<BaseLayout title="Destinations & Group Travel Experiences | Talon Expeditions" description="Explore Talon Expeditions group travel styles including private group travel, learn-to trips, trekking and active travel, cultural journeys, wildlife, wellness, water, and island travel." image={images.train} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.train}')`}><div class="shell"><h1>Destinations</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Destinations</p><h2>Explore Popular Travel Experiences</h2></div><p>Talon Expeditions plans worldwide rather than selling one narrow destination list. These experience paths show how the itinerary changes depending on what the group wants to do, learn, and experience.</p><a class="button button-small" href="/plan-a-trip/">Plan Your Trip</a></div><div class="av-destination-grid">{cards.map((item,index)=><a class="av-destination-card" href={item.href} style={`background-image:url('${item.image}')`}><div class="av-destination-card-top"><span>{index<3?'Featured experience':'More ways to travel'}</span><span class="av-card-arrow">↗</span></div><h3>{item.title}</h3><p>{item.copy}</p><div class="av-destination-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></a>)}</div></div></section>
  <section class="av-proof-band" style={`background-image:url('${images.coast}')`}><div class="shell"><div class="av-proof-head"><p class="eyebrow">Travel your way</p><h2>A destination becomes useful when it fits the group.</h2></div><div class="av-proof-grid"><div class="av-proof-card"><div class="stars">★★★★★</div><h3>Start with the people</h3><p>Group size, experience, budget, rooming, origin cities, pace, and shared interests change what a destination can realistically support.</p><small>Group-first planning</small></div><div class="av-proof-card"><div class="stars">★★★★★</div><h3>Match season to experience</h3><p>Weather, daylight, water conditions, snow, wildlife patterns, crowds, local events, and operating seasons can matter as much as the destination name.</p><small>Destination fit</small></div><div class="av-proof-card"><div class="stars">★★★★★</div><h3>Protect the reason to go</h3><p>A good itinerary prioritizes the experiences that matter most and avoids filling every day simply because another attraction exists.</p><small>Experience-led design</small></div></div></div></section>
  <section class="av-process"><div class="shell av-process-grid"><div class="av-process-visual" style={`background-image:url('${images.road}')`}><div class="av-process-callout"><h3>Not sure where to go?</h3><p>Start with what the group wants from the trip. We can compare destinations against the same practical criteria.</p></div></div><div class="av-process-copy"><p class="eyebrow">How it Works</p><h2>Choose the experience before forcing the destination.</h2><p class="av-process-lead">The strongest destination is the one that fits the season, group, travel time, activity, comfort level, and budget together.</p><div class="av-process-topline"><strong>Compare destination options</strong><a href="/custom-group-trip-planning/">↗</a></div><div class="av-process-steps"><div class="av-process-step"><div class="av-process-icon">⌖</div><div><h3>Define the Group</h3><p>Understand who is traveling and what needs to work for them.</p></div></div><div class="av-process-step"><div class="av-process-icon">☀</div><div><h3>Check the Season</h3><p>Match weather and operating conditions to the experience.</p></div></div><div class="av-process-step"><div class="av-process-icon">▣</div><div><h3>Shape the Route</h3><p>Balance travel time, activity, culture, comfort, and free time.</p></div></div><div class="av-process-step"><div class="av-process-icon">▤</div><div><h3>Confirm Support</h3><p>Connect lodging, transport, operators, guides, and readiness.</p></div></div></div></div></div></section>
</BaseLayout>
