---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQList from '../../components/FAQList.astro';
import { mainFaqGroups, faqPages } from '../../data/faqs';
import { images } from '../../data/assets';
const breadcrumbs=[{label:'FAQ',href:'/faq/'}];
const all=mainFaqGroups.flatMap((g)=>g.items);
const faqSchema={'@type':'FAQPage',mainEntity:all.map((item)=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))};
---
<BaseLayout title="Talon Expeditions FAQ | Group Travel Planning Questions" description="Answers to common questions about Talon Expeditions, private group travel, active trips, learn-to travel, support, booking, preparation, and worldwide trip planning." image={images.toronto} breadcrumbs={breadcrumbs} schema={faqSchema}>
  <section class="av-inner-hero" style={`background-image:url('${images.toronto}')`}><div class="shell"><h1>FAQ</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell av-faq-layout"><div class="av-faq-title"><p class="eyebrow">Frequently Asked Questions</p><h2>Have Questions?<br/>We’ve Got Answers.</h2></div><div class="av-faq-stack">{mainFaqGroups.map((group)=><section class="av-faq-group"><h3>{group.title}</h3><FAQList items={group.items} openFirst={true}/></section>)}</div></div><div class="shell av-faq-more">{faqPages.map((page)=><a href={`/faq/${page.slug}/`}><small>Deeper FAQ Library</small><strong>{page.title}</strong></a>)}</div></section>
</BaseLayout>
