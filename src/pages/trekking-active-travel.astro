---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { activePages } from '../data/landing';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Trekking & Active Travel',href:'/trekking-active-travel/'}];
const cards=[
 ...activePages.map((page)=>({title:page.title,image:page.hero,copy:page.description,href:`/trekking-active-travel/${page.slug}/`,tags:['Active','Supported','Groups']})),
 {title:'Mountain & Peak Programs',image:images.fuji,copy:'Mountain travel built around appropriate objectives, local expertise, acclimatization, weather, and group readiness rather than summit marketing alone.',href:'/plan-a-trip/',tags:['Mountains','Objectives','Readiness']},
 {title:'Active Cultural Travel',image:images.marrakech,copy:'Walk, hike, paddle, cycle, or move through a region while keeping food, communities, history, and local context central to the journey.',href:'/cultural-cruise-travel/cultural-group-travel/',tags:['Culture','Movement','Discovery']},
 {title:'Hiking Club Travel',image:images.backpacker,copy:'Group travel for hiking communities that care about route quality, difficulty, member fit, support, and outdoor experience.',href:'/group-travel/hiking-clubs/',tags:['Clubs','Trails','Private group']},
 {title:'Beginner Active Escapes',image:images.lake,copy:'Meaningful activity with comfortable recovery and a pace that gives newer active travelers room to build confidence.',href:'/trekking-active-travel/beginner-active-trips/',tags:['Beginner-friendly','Comfort','Active rest']}
];
---
<BaseLayout title="Trekking & Active Group Travel | Talon Expeditions" description="Supported trekking, hiking, mountain and active group travel for clubs, communities and private groups, with route planning, local specialists, logistics, and traveler preparation." image={images.trekking} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.trekking}')`}><div class="shell"><h1>Trekking & Active Travel</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Active Journeys</p><h2>Move Through the Place Instead of Only Looking at It</h2></div><p>Supported hiking, trekking, mountain, and active journeys where route difficulty, pacing, accommodation, local expertise, logistics, and traveler preparation are designed around the people actually going.</p><a class="button button-small" href="/plan-a-trip/">Plan an Active Trip</a></div><div class="av-destination-grid">{cards.map((item)=><a class="av-destination-card" href={item.href} style={`background-image:url('${item.image}')`}><div class="av-destination-card-top"><span>Active journey</span><span class="av-card-arrow">↗</span></div><h3>{item.title}</h3><p>{item.copy}</p><div class="av-destination-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></a>)}</div></div></section>
  <section class="av-proof-band" style={`background-image:url('${images.road}')`}><div class="shell"><div class="av-proof-head"><p class="eyebrow">Supported Active Travel</p><h2>Active does not have to mean extreme.</h2></div><div class="av-proof-grid"><div class="av-proof-card"><h3>Describe Difficulty Practically</h3><p>Distance, elevation, terrain, altitude, time moving, consecutive days, weather exposure, and available support tell travelers more than a vague rating.</p><small>Trip fit</small></div><div class="av-proof-card"><h3>Plan Recovery Too</h3><p>Accommodation, meals, transfers, rest, and lighter days should match the repeated effort rather than being designed separately.</p><small>Itinerary rhythm</small></div><div class="av-proof-card"><h3>Use Local Expertise</h3><p>Guides, permits, technical providers, transport, luggage support, and local operating rules are integrated where the route requires them.</p><small>Destination capability</small></div></div></div></section>
  <section class="av-process"><div class="shell av-process-grid"><div class="av-process-visual" style={`background-image:url('${images.lake}')`}><div class="av-process-callout"><h3>Prepare for the Repeated Effort</h3><p>A traveler may handle one difficult day and still need preparation for doing it again after limited recovery.</p></div></div><div class="av-process-copy"><p class="eyebrow">How it Works</p><h2>The Route, Recovery, Logistics, and Support Have to Agree</h2><p class="av-process-lead">A beautiful trail is not enough. The route has to work with travel days, accommodation, weather, local transport, group pace, meals, luggage, and the number of active days travelers can realistically sustain.</p><div class="av-process-topline"><strong>Trip preparation resources</strong><a href="/resources/trip-preparation/">↗</a></div><div class="av-process-steps"><div class="av-process-step"><div class="av-process-icon">⌖</div><div><h3>Route Demand</h3><p>Distance, elevation, terrain, altitude, pack weight, and time moving.</p></div></div><div class="av-process-step"><div class="av-process-icon">☀</div><div><h3>Season & Conditions</h3><p>Weather, daylight, trail conditions, operating seasons, and contingency.</p></div></div><div class="av-process-step"><div class="av-process-icon">▣</div><div><h3>Support Model</h3><p>Guides, transport, luggage, accommodation, equipment, and local operators.</p></div></div><div class="av-process-step"><div class="av-process-icon">✓</div><div><h3>Traveler Readiness</h3><p>Fitness, equipment testing, expectations, documents, and activity requirements.</p></div></div></div></div></div></section>
</BaseLayout>
