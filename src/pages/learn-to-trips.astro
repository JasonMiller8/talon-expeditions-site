---
import BaseLayout from '../layouts/BaseLayout.astro';
import { images } from '../data/assets';
const skills=[
  {title:'Scuba & Dive',copy:'Travel built around instruction, certification or progression in the water.',image:images.water,tags:['Beginner','Progression']},
  {title:'Surf',copy:'A destination where the days revolve around learning, practice, water time and recovery.',image:images.surf,tags:['Ocean','Skill-based']},
  {title:'Sailing',copy:'Turn a coastal journey into practical time learning to handle a boat and move under sail.',image:images.paddle,tags:['Coastal','Hands-on']},
  {title:'Mountaineering',copy:'Structured progression toward mountain skills, movement, systems and more technical objectives.',image:images.trekking,tags:['Mountain','Progression']},
  {title:'Ski',copy:'Travel designed around learning or improving on snow without losing the experience of the place.',image:images.fuji,tags:['Winter','Beginner-ready']},
  {title:'Wilderness Skills',copy:'Navigation, campcraft, outdoor systems and practical confidence taught in a real environment.',image:images.road,tags:['Outdoor','Capability']}
];
---
<BaseLayout title="Learn-To Trips | Talon Expeditions" description="Skill-based travel built around learning to dive, sail, ski, surf, climb, mountaineer, and develop wilderness skills." image={images.surf}>
  <section class="page-hero" style={`background-image:url('${images.surf}')`}><div class="shell"><p class="eyebrow">Learn-To Trips</p><h1 class="section-title">Go somewhere worth remembering. Come home able to do something new.</h1><p>Skill-based travel where the learning is part of the reason for going, not an activity squeezed into an ordinary vacation.</p></div></section>

  <section class="specialty-intro"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">Choose what you want to learn</p><h2 class="section-title">The destination supports the skill.</h2></div><p class="section-copy">Each skill gets its own travel direction, visual identity, preparation needs, and progression model instead of being buried in a generic package list.</p></div><div class="destination-grid">{skills.map((item)=><a class="destination-card" href="/contact/" style={`background-image:url('${item.image}')`}><div class="destination-content"><span class="tagline">Learn-To experience</span><h3>{item.title}</h3><p>{item.copy}</p><div class="mini-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></div></a>)}</div></div></section>

  <section class="section"><div class="shell"><div class="detail-gallery"><div class="gallery-main" style={`background-image:url('${images.coast}')`}></div><div style={`background-image:url('${images.coastalTraveler}')`}></div><div style={`background-image:url('${images.cliff}')`}></div></div><div class="detail-body"><aside class="trip-facts"><h3>A Learn-To trip is built around progression.</h3><div class="fact"><strong>Starting point</strong><span>Complete beginner, returning participant, or progressing group.</span></div><div class="fact"><strong>Instruction</strong><span>Qualified local instruction appropriate to the activity and destination.</span></div><div class="fact"><strong>Travel design</strong><span>Lodging, transport, recovery time, and the rest of the trip support the learning objective.</span></div><div class="fact"><strong>Group fit</strong><span>Pace and expectations shaped around the actual people traveling.</span></div></aside><div class="overview-panel"><p class="eyebrow">What makes it different</p><h2>Learning is not an add-on. It is the structure of the journey.</h2><p>A useful Learn-To trip leaves enough time to understand, practice, improve, and actually use the skill. That means the itinerary cannot be designed like a sightseeing schedule with a lesson dropped into the middle.</p><div class="check-grid"><span>Instruction integrated into the itinerary</span><span>Time to practice instead of rushing onward</span><span>Clear beginner or progression expectations</span><span>Equipment and preparation considered early</span><span>Recovery and free time built around activity</span><span>Travel logistics matched to the learning plan</span></div><div class="day-grid"><div class="day-card"><span class="day-label">Stage 01</span><h3>Foundation</h3><p>Arrive, orient, meet instructors, understand systems, and establish the starting point.</p></div><div class="day-card"><span class="day-label">Stage 02</span><h3>Progress</h3><p>Repeat, practice, receive feedback, and build confidence through real participation.</p></div><div class="day-card"><span class="day-label">Stage 03</span><h3>Use It</h3><p>Finish with a meaningful objective or experience where the new capability becomes part of the trip.</p></div></div></div></div></div></section>

  <section class="section tabbed-feature"><div class="shell tabbed-grid"><div><p class="eyebrow">Designed for real beginners</p><h2 class="section-title">Capability without turning the trip into boot camp.</h2><ul class="category-menu"><li class="active">Clear expectations</li><li>Qualified instruction</li><li>Useful preparation</li><li>Reasonable progression</li><li>Enough downtime</li></ul></div><div class="category-feature" style={`background-image:url('${images.packing}')`}><div class="feature-note"><h3>Preparation starts before departure.</h3><p>For equipment-heavy or physically demanding skills, traveler readiness is part of the product. The goal is fewer surprises once the group arrives.</p></div></div></div></section>

  <section class="specialty-cta"><div class="shell"><h2>What would your group like to learn somewhere unforgettable?</h2><a class="button button-secondary" href="/contact/">Shape a Learn-To Trip</a></div></section>
</BaseLayout>
