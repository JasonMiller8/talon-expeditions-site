---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { learnToPages } from '../data/landing';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Learn-To Trips',href:'/learn-to-trips/'}];
const cards=[
 ...learnToPages.map((page)=>({title:page.title,image:page.hero,copy:page.description,href:`/learn-to-trips/${page.slug}/`,tags:['Instruction','Progression','Travel']})),
 {title:'Learn to Sail',image:images.boat,copy:'Sailing-focused travel can combine onboard learning, coastal exploration, teamwork, and destination time when the right provider and vessel are available.',href:'/plan-a-trip/',tags:['Developing format','Water','Skill-based']},
 {title:'Learn to Surf',image:images.surf,copy:'Beginner surf travel works best when instruction, beach conditions, recovery, equipment, accommodation, and destination time are planned together.',href:'/plan-a-trip/',tags:['Developing format','Coast','Beginner-friendly']}
];
---
<BaseLayout title="Learn-To Trips & Skill-Based Travel | Talon Expeditions" description="Skill-based group travel built around learning scuba diving, skiing, mountaineering, wilderness skills, sailing, surfing, and other activities with structured instruction and travel support." image={images.surf} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.surf}')`}><div class="shell"><h1>Learn-To Trips</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Skill-Based Travel</p><h2>Go Somewhere Worth Remembering. Come Home Able to Do Something New.</h2></div><p>A Learn-To Trip is designed around skill development. Instruction, practice, equipment, prerequisites, recovery, and progression are important enough to shape the destination and daily schedule.</p><a class="button button-small" href="/plan-a-trip/">Plan a Learn-To Trip</a></div><div class="av-destination-grid">{cards.map((item)=><a class="av-destination-card" href={item.href} style={`background-image:url('${item.image}')`}><div class="av-destination-card-top"><span>Skill-based travel</span><span class="av-card-arrow">↗</span></div><h3>{item.title}</h3><p>{item.copy}</p><div class="av-destination-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></a>)}</div></div></section>
  <section class="av-proof-band" style={`background-image:url('${images.water}')`}><div class="shell"><div class="av-proof-head"><p class="eyebrow">A Real Learning Itinerary</p><h2>The course and the travel plan have to fit each other.</h2></div><div class="av-proof-grid"><div class="av-proof-card"><h3>Qualified Instruction</h3><p>Appropriate specialist providers deliver technical instruction. Talon coordinates the wider travel and program around those requirements.</p><small>Provider fit</small></div><div class="av-proof-card"><h3>Protected Practice Time</h3><p>Beginners need time to absorb information, repeat skills, recover, and progress without transfers competing with every session.</p><small>Learning rhythm</small></div><div class="av-proof-card"><h3>Visible Requirements</h3><p>Starting level, fitness, age, certification, equipment, or pre-course requirements should be clear before someone commits.</p><small>Traveler readiness</small></div></div></div></section>
  <section class="av-process"><div class="shell av-process-grid"><div class="av-process-visual" style={`background-image:url('${images.packing}')`}><div class="av-process-callout"><h3>Learning Needs Repetition</h3><p>The trip still needs room to breathe. Training, recovery, culture, and destination time should support each other.</p></div></div><div class="av-process-copy"><p class="eyebrow">How Learn-To Travel Works</p><h2>Build the Destination Around the Learning Goal</h2><p class="av-process-lead">The skill becomes a core planning variable rather than an optional excursion dropped into a normal vacation.</p><div class="av-process-topline"><strong>Explore beginner trip planning</strong><a href="/guides/how-do-learn-to-trips-work-for-beginners/">↗</a></div><div class="av-process-steps"><div class="av-process-step"><div class="av-process-icon">◎</div><div><h3>Starting Level</h3><p>Clarify what participants can already do and what the intended progression should be.</p></div></div><div class="av-process-step"><div class="av-process-icon">⌖</div><div><h3>Right Setting</h3><p>Choose a destination and season that support the activity and the wider travel experience.</p></div></div><div class="av-process-step"><div class="av-process-icon">▣</div><div><h3>Instruction & Equipment</h3><p>Match providers, equipment, ratios, and prerequisites to the group.</p></div></div><div class="av-process-step"><div class="av-process-icon">☀</div><div><h3>Practice & Recovery</h3><p>Protect enough time to build confidence without making the whole trip feel like a course.</p></div></div></div></div></div></section>
</BaseLayout>
