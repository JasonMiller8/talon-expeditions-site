---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlanningCTA from '../components/PlanningCTA.astro';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Travel Planning Services',href:'/services/'}];
const services=[
  ['Trip strategy & design','Define the group, purpose, destination options, route, pace, duration, comfort, and support level before the itinerary hardens.'],
  ['Air & arrival planning','Coordinate or structure flights, common arrival windows, airport transfers, and the practical handoff into the trip.'],
  ['Accommodation & rooming','Match hotels, resorts, lodges, cabins, huts, or other lodging to the group and manage rooming assumptions.'],
  ['Ground transport','Private vehicles, rail, ferries, local transfers, luggage movement, and the connections between each travel day.'],
  ['Activities & local operators','Coordinate destination specialists, guides, instructors, excursions, tickets, and activity suppliers appropriate to the itinerary.'],
  ['Organizer support','Help the group leader structure the trip information, launch process, participant questions, and planning milestones.'],
  ['Traveler readiness','Clarify documents, insurance, activity prerequisites, fitness, equipment, packing, and the information travelers need before departure.'],
  ['On-trip coordination','Define who supports the trip on the ground, how travelers reach help, and how local suppliers, hosts, guides, or Talon staff fit together.'],
  ['Extensions & additional travel','Where practical, help travelers add pre-trip or post-trip nights, independent stays, or related travel around the core group journey.']
];
const schema={'@type':'Service',name:'Group Travel Planning Services',description:'Trip design, travel coordination, organizer support, traveler preparation, and worldwide group travel services from Talon Expeditions.',provider:{'@id':`${Astro.site}#organization`},areaServed:{'@type':'Place',name':'Worldwide'}};
---
<BaseLayout title="Group Travel Planning Services | Talon Expeditions" description="Trip design, flights, accommodation, transport, activities, organizer support, traveler readiness, and worldwide group travel coordination from Talon Expeditions." image={images.train} breadcrumbs={breadcrumbs} schema={schema}>
  <section class="page-hero" style={`background-image:url('${images.train}')`}><div class="shell"><Breadcrumbs items={breadcrumbs}/><p class="eyebrow">Travel planning services</p><h1 class="section-title">The moving parts of a group trip, connected into one workable plan.</h1><p>Talon Expeditions supports organizers and travelers across the planning lifecycle. The exact scope varies by trip, but the objective is consistent: reduce fragmentation, make responsibilities clear, and build travel around the people and experience rather than around disconnected bookings.</p></div></section>
  <section class="specialty-intro"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">What we can support</p><h2 class="section-title">Travel services that work together.</h2></div><p class="section-copy">Not every trip needs every service. We define the support model around the itinerary, destination, traveler mix, and organizer’s role.</p></div><div class="donor-grid">{services.map((item,index)=><div class="donor-card"><span class="card-index">{String(index+1).padStart(2,'0')}</span><h3>{item[0]}</h3><p>{item[1]}</p></div>)}</div></div></section>
  <section class="section dark-section"><div class="shell mission-grid"><div><p class="eyebrow">What “supported” should mean</p><h2 class="section-title">Clear scope is more useful than vague promises.</h2><p style="color:#aaa">A travel company should be explicit about what it plans, books, coordinates, hosts, guides, and leaves to the traveler. That is especially important on active or specialist trips where local operators and instructors may own part of the experience.</p></div><div class="mission-stack"><div class="mission-card"><h3>Planned by Talon</h3><p>Trip design, organizer coordination, participant information, and the overall travel structure may be led by Talon.</p></div><div class="mission-card"><h3>Delivered with local specialists</h3><p>Destination-specific guiding, instruction, marine activities, mountain programs, cruises, or local operations may be delivered by appropriately selected suppliers.</p></div><div class="mission-card"><h3>Owned by the traveler</h3><p>Passports, visas, personal medical decisions, required insurance, individual fitness, and compliance with activity requirements remain personal responsibilities.</p></div></div></div></section>
  <section class="section"><div class="shell split-copy-image"><div class="split-image" style={`background-image:url('${images.packing}')`}></div><div><p class="eyebrow">Before departure</p><h2 class="section-title">Preparation is part of the travel service.</h2><p class="section-copy">For a city break, preparation may be simple. For a trek, dive program, ski trip, or remote itinerary, it can be a substantial part of whether the trip runs well. We treat readiness as operational work rather than an afterthought.</p><div class="check-grid"><span>Passport and entry requirements</span><span>Insurance and supplier requirements</span><span>Equipment and packing</span><span>Fitness and activity expectations</span><span>Rooming and traveler details</span><span>Arrival and transfer instructions</span><span>Training or certification prerequisites</span><span>Final itinerary and support contacts</span></div><a class="button" href="/support/">See Support & What’s Included</a></div></div></section>
  <PlanningCTA title="Use as much planning support as the trip actually needs." />
</BaseLayout>
