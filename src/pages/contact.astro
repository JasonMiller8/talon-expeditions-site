---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { images } from '../data/assets';
import { business } from '../data/site';
const breadcrumbs=[{label:'Contact Us',href:'/contact/'}];
---
<BaseLayout title="Contact Talon Expeditions" description="Contact Talon Expeditions for private group travel, trip planning, supplier inquiries, media questions, and general travel support. U.S.-based planning for worldwide travel." image={images.surf} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.surf}')`}><div class="shell"><h1>Contact Us</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="av-contact-overlap"><div class="shell av-contact-stage" style={`background-image:url('${images.planning}')`}><div class="av-contact-info"><div class="av-contact-info-card"><div class="av-service-card-icon">◷</div><h3>New Trip Inquiries</h3><p>Use the Plan a Trip form when you already have a group, destination, activity, or trip idea.</p></div><div class="av-contact-info-card" style="background:var(--av-red);color:#fff"><div class="av-service-card-icon" style="color:#fff">⌖</div><h3 style="color:#fff">Our U.S. Office</h3><p style="color:#fff">{business.address.street}<br/>{business.address.city}, {business.address.region} {business.address.postalCode}<br/>{business.phone}<br/>{business.email}</p></div><div class="av-contact-info-card"><div class="av-service-card-icon">◎</div><h3>Current Travelers</h3><p>Confirmed travelers should use the trip-specific support contacts in their final travel documents for urgent or departure-specific questions.</p></div></div></div></section>
  <section class="av-contact-split shell"><div class="av-contact-copy"><p class="eyebrow">Contact Us</p><h2>Let’s Start Planning Your Journey</h2><p>Have a question, need assistance, want to introduce a destination supplier, or have a group travel idea? Use the form or contact us directly. For a new trip, the planning form captures more useful context.</p><h3>Other Ways to Reach Us</h3><div class="av-contact-method"><i>✉</i><div><h3>Email</h3><a href={`mailto:${business.email}`}>{business.email}</a></div></div><div class="av-contact-method"><i>☎</i><div><h3>Phone</h3><a href={`tel:${business.phoneHref}`}>{business.phone}</a></div></div><div class="av-contact-method"><i>↗</i><div><h3>Planning Inquiry</h3><a href="/plan-a-trip/">Start a detailed trip request</a></div></div></div><form data-mailto-form data-subject="Talon Expeditions contact inquiry" class="av-contact-form" action={`mailto:${business.email}`} method="post" enctype="text/plain"><div><label for="contact-name">Full Name</label><input id="contact-name" name="name" required placeholder="Enter your full name"/></div><div><label for="contact-email">Email Address</label><input id="contact-email" name="email" type="email" required placeholder="Enter your email"/></div><div><label for="contact-topic">Subject</label><select id="contact-topic" name="topic"><option>General question</option><option>Existing trip / traveler support</option><option>Supplier or destination partner</option><option>Guide / instructor / specialist</option><option>Media / press</option><option>Business partnership</option><option>Other</option></select></div><div><label for="contact-phone">Phone Number</label><input id="contact-phone" name="phone" type="tel" placeholder="Enter your phone number"/></div><div class="full"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required placeholder="Write your message here"></textarea></div><div class="full"><button class="button" type="submit">Send Message</button></div></form></section>
  <section class="av-contact-map" style={`background-image:url('${images.road}')`}><div class="av-contact-map-card"><h2>Let’s Plan Something Incredible</h2><p>Start with the people, the destination, the activity, or simply the kind of experience you want to create. A finished itinerary is not required.</p><a class="button button-small" href="/plan-a-trip/">Schedule a Trip Call</a></div></section>
</BaseLayout>
