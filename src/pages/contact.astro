---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { images } from '../data/assets';
import { business } from '../data/site';
const breadcrumbs=[{label:'Contact',href:'/contact/'}];
---
<BaseLayout title="Contact Talon Expeditions" description="Contact Talon Expeditions for private group travel, trip planning, supplier inquiries, media questions, and general travel support. U.S.-based planning for worldwide travel." image={images.city} breadcrumbs={breadcrumbs}>
  <section class="page-hero" style={`background-image:url('${images.city}')`}><div class="shell"><Breadcrumbs items={breadcrumbs}/><p class="eyebrow">Contact Talon Expeditions</p><h1 class="section-title">Trip question, group idea, supplier introduction, or something else?</h1><p>Use the planning inquiry when you already have a trip in mind. Use this page for general questions, existing-trip support, supplier or guide introductions, partnerships, and company contact.</p></div></section>
  <section class="section"><div class="shell contact-grid"><div><p class="eyebrow">Talk with Talon</p><h2 class="section-title">Use the channel that fits the question.</h2><p class="section-copy">For a new group trip, the planning form captures more useful context. For general or operational questions, email or phone is fine.</p><div class="contact-card" style="margin-top:28px"><strong>Email</strong><p><a href={`mailto:${business.email}`}>{business.email}</a></p><strong>Phone</strong><p><a href={`tel:${business.phoneHref}`}>{business.phone}</a></p><strong>U.S. correspondence</strong><p>{business.address.street}<br/>{business.address.city}, {business.address.region} {business.address.postalCode}</p><a class="button" href="/plan-a-trip/">Planning a Trip? Start Here</a></div></div><form data-mailto-form data-subject="Talon Expeditions contact inquiry" class="form-panel contact-form" action={`mailto:${business.email}`} method="post" enctype="text/plain"><div><label for="contact-name">Name</label><input id="contact-name" name="name" required/></div><div><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" required/></div><div><label for="contact-phone">Phone</label><input id="contact-phone" name="phone" type="tel"/></div><div><label for="contact-topic">Topic</label><select id="contact-topic" name="topic"><option>General question</option><option>Existing trip / traveler support</option><option>Supplier or destination partner</option><option>Guide / instructor / specialist</option><option>Media / press</option><option>Business partnership</option><option>Other</option></select></div><div class="full"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required></textarea></div><div class="full"><button class="button" type="submit">Send Message</button><p class="form-note">Prefer to email directly? You can also write to sales@talonexpeditions.com.</p></div></form></div></section>
  <section class="section dark-section"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">Business hours & response</p><h2 class="section-title">Travel crosses time zones. The company still needs a clear home base.</h2></div><p class="section-copy" style="color:#aaa">Talon Expeditions is U.S.-based and works with worldwide destinations. Response timing depends on the inquiry, travel operations, and time-zone differences. Urgent support instructions for confirmed travelers are provided with the specific trip.</p></div><div class="office-grid"><div class="office-card" style="background:#171310"><h3 style="color:#fff">New trip inquiries</h3><p style="color:#aaa">Use the Plan a Trip form so we can see the group, travel style, timing, and constraints in one place.</p></div><div class="office-card" style="background:#171310"><h3 style="color:#fff">Confirmed travelers</h3><p style="color:#aaa">Use the support contact provided in your trip documents when the question is time-sensitive or departure-specific.</p></div><div class="office-card" style="background:#171310"><h3 style="color:#fff">Partners & specialists</h3><p style="color:#aaa">Email a concise introduction with destination, activity, qualifications, services, and relevant operational details.</p></div></div></div></section>
</BaseLayout>
