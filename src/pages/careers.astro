---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Careers',href:'/careers/'}];
const interests=[
  ['Trip Planning & Operations','For experienced travel professionals who understand itinerary design, supplier coordination, group operations, and traveler communication.'],
  ['Destination Specialists','For people with deep, practical knowledge of destinations, logistics, operators, languages, and local travel realities.'],
  ['Guides & Activity Specialists','For qualified professionals in trekking, mountaineering, diving, sailing, skiing, wilderness skills, culture, or other trip-specific disciplines.'],
  ['Group Hosts & Community Travel','For people experienced in leading groups, traveler care, community dynamics, and keeping a trip moving without turning it into a rigid tour.'],
  ['Travel Content & Field Documentation','For writers, photographers, and content specialists who can turn real planning knowledge and trip experience into useful public resources.']
];
---
<BaseLayout title="Careers & Specialist Network | Talon Expeditions" description="Career and specialist-network information for travel planners, destination specialists, guides, instructors, group hosts, and field-content professionals interested in Talon Expeditions." image={images.road} breadcrumbs={breadcrumbs}>
  <section class="page-hero" style={`background-image:url('${images.road}')`}><div class="shell"><Breadcrumbs items={breadcrumbs}/><p class="eyebrow">Careers & specialist network</p><h1 class="section-title">Good group travel depends on people who understand both the experience and the operations.</h1><p>Talon Expeditions recruits selectively as trip volume and destination programs expand. We also maintain relationships with destination specialists, operators, guides, instructors, hosts, and other professionals who may support specific journeys.</p></div></section>
  <section class="section"><div class="shell definition-grid"><div class="definition-sticky"><p class="eyebrow">Current status</p><h2>We are not advertising broad open hiring at this time.</h2></div><div class="definition-body"><div class="answer-panel"><h2>Can I apply to work with Talon Expeditions?</h2><p>Yes, as an expression of interest. We are not presenting the roles below as currently open jobs. Qualified travel and activity professionals can introduce themselves for future staff, contractor, supplier, guide, instructor, host, or destination-network opportunities.</p></div><p>We prefer a smaller network of people who can explain how they work over a large list of generic resumes. If your background is relevant, tell us where you operate, what you actually do, which qualifications or licenses matter, what types of groups you work with, and where your experience is strongest.</p></div></div></section>
  <section class="section soft-section"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">Areas of interest</p><h2 class="section-title">Where future opportunities may develop.</h2></div><p class="section-copy">These are talent and partner categories, not active vacancy claims.</p></div><div class="job-list">{interests.map((item)=><div class="job-row"><div><h3>{item[0]}</h3><p>{item[1]}</p></div><span class="status-pill">Expression of interest</span></div>)}</div></div></section>
  <section class="section dark-section"><div class="shell contact-grid"><div><p class="eyebrow">Introduce yourself</p><h2 class="section-title">Send practical information, not a generic pitch.</h2><p style="color:#aaa">Include your location, professional background, relevant qualifications, languages, destinations or activities, group experience, availability model, and links that help us verify your work.</p></div><div class="form-panel" style="color:var(--ink)"><h2>Specialist network inquiries</h2><p>Send a concise introduction to <a href="mailto:sales@talonexpeditions.com">sales@talonexpeditions.com</a> with the subject line <strong>Specialist Network</strong>. If you are applying for future internal work rather than supplier/guide collaboration, say so clearly in the first paragraph.</p><a class="button" href="mailto:sales@talonexpeditions.com?subject=Specialist%20Network">Email Talon Expeditions</a></div></div></section>
</BaseLayout>
