---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Gallery',href:'/gallery/'}];
const items=[
 ['Trekking & Mountain Travel',images.trekking],['Island & Coastal Travel',images.coast],['Dive & Marine Experiences',images.water],['Wildlife & Nature',images.wildlife],['Culture & Cities',images.culture],['Overland Journeys',images.road]
];
---
<BaseLayout title="Experience Gallery | Talon Expeditions" description="Visual inspiration for Talon Expeditions trip styles including trekking, active travel, diving, wildlife, cultural travel, cruises, coastlines, and skill-based journeys." image={images.galleryTravel} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.galleryTravel}')`}><div class="shell"><h1>Gallery</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-gallery-title"><p class="eyebrow">Travel Moments</p><h2>Explore the Landscapes, Activities, and Travel Styles We Build Around</h2><p>This gallery is directional rather than a claim that every image depicts a Talon-operated departure. Individual trip pages identify the actual destination, suppliers, dates, and operating details for each real journey.</p></div><div class="av-gallery-grid">{items.map(([label,image])=><div class="av-gallery-tile" style={`background-image:url('${image}')`}><span>{label}</span></div>)}</div><div style="text-align:center;margin-top:34px"><span class="eyebrow">Share Your Journey, Build Your Next One</span></div></div></section>
  <section class="av-category-stage"><div class="shell av-category-grid"><div><p class="eyebrow">Tour Categories</p><h2 class="section-title">Choose Your Travel Style</h2><p class="av-category-copy">Use the imagery for inspiration, then go deeper into the planning model that fits your group.</p><ul class="av-category-menu"><li>Nature & Wildlife</li><li>Trekking & Active</li><li>Islands & Water</li><li>Learn-To Travel</li><li>Culture & Cruise</li><li>Private Groups</li></ul></div><div class="av-category-visual" style={`background-image:url('${images.paddle}')`}><div class="av-category-caption"><h3>Experience first. Itinerary second.</h3><p>The best trip protects the reason people want to go instead of filling the schedule with everything that happens to be nearby.</p><a class="button button-small" href="/experiences/">Explore Experiences</a></div></div></div></section>
  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Destinations</p><h2>Explore More Ways to Travel</h2></div><p>Private groups can combine active, cultural, wildlife, water, wellness, and skill-based elements when the destination and group make that combination practical.</p><a class="button button-small" href="/plan-a-trip/">Start Planning</a></div><div class="av-destination-grid"><a class="av-destination-card" href="/trekking-active-travel/" style={`background-image:url('${images.fuji}')`}><div class="av-destination-card-top"><span>Mountains</span><span class="av-card-arrow">↗</span></div><h3>Trekking & Active Travel</h3><p>Supported hiking, mountain, and active journeys shaped around route difficulty, comfort, and readiness.</p></a><a class="av-destination-card" href="/cultural-cruise-travel/" style={`background-image:url('${images.marrakech}')`}><div class="av-destination-card-top"><span>Culture</span><span class="av-card-arrow">↗</span></div><h3>Cultural Journeys</h3><p>Shared discovery, food, history, neighborhoods, landscapes, and enough independent time to enjoy being there.</p></a><a class="av-destination-card" href="/learn-to-trips/" style={`background-image:url('${images.surf}')`}><div class="av-destination-card-top"><span>Skills</span><span class="av-card-arrow">↗</span></div><h3>Learn-To Trips</h3><p>Travel where instruction, practice, progression, and the destination work together.</p></a></div></div></section>
</BaseLayout>
