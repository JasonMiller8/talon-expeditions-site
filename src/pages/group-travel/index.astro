---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { groupTravelPages } from '../../data/landing';
import { images } from '../../data/assets';
const breadcrumbs=[{label:'Group Travel',href:'/group-travel/'}];
---
<BaseLayout title="Private Group Travel for Clubs, Communities & Teams | Talon Expeditions" description="Custom private group travel for hiking clubs, dive communities, wellness groups, businesses, social groups, and organizers, with worldwide planning and traveler support." image={images.group} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.group}')`}><div class="shell"><h1>Group Travel</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">For Groups & Communities</p><h2>Bring the Community. Build the Trip Around Them.</h2></div><p>Talon Expeditions plans private and organizer-led group travel for clubs, communities, businesses, studios, teams, and affinity groups. The itinerary changes when the people, purpose, pace, and organizer needs change.</p><a class="button button-small" href="/plan-a-trip/">Plan a Group Trip</a></div><div class="av-destination-grid">{groupTravelPages.map((page)=><a class="av-destination-card" href={`/group-travel/${page.slug}/`} style={`background-image:url('${page.hero}')`}><div class="av-destination-card-top"><span>Private group travel</span><span class="av-card-arrow">↗</span></div><h3>{page.title}</h3><p>{page.description}</p><div class="av-destination-tags"><span>Custom</span><span>Supported</span><span>Organizer-led</span></div></a>)}</div></div></section>
  <section class="av-proof-band" style={`background-image:url('${images.road}')`}><div class="shell"><div class="av-proof-head"><p class="eyebrow">The Organizer Side</p><h2>A good itinerary is only useful if people can understand, join, and prepare for it.</h2></div><div class="av-proof-grid"><div class="av-proof-card"><h3>Viability</h3><p>Test group size, timing, cost, destination, activity, and support assumptions before the trip is overcommitted.</p><small>Early planning</small></div><div class="av-proof-card"><h3>Clarity</h3><p>Explain inclusions, pace, rooming, requirements, deadlines, and what participants need to decide.</p><small>Participant information</small></div><div class="av-proof-card"><h3>Readiness</h3><p>Give travelers enough time to resolve documents, fitness, equipment, insurance, and activity prerequisites.</p><small>Before departure</small></div></div></div></section>
  <section class="av-process"><div class="shell av-process-grid"><div class="av-process-visual" style={`background-image:url('${images.planning}')`}><div class="av-process-callout"><h3>Start Before the Plan Is Finished</h3><p>Early decisions are easier to change than confirmed supplier commitments.</p></div></div><div class="av-process-copy"><p class="eyebrow">How it Works</p><h2>A Planning Sequence Designed for Groups</h2><p class="av-process-lead">We begin with the people and purpose, then move into destination and logistics. That order usually produces a more realistic trip and clearer information for participants.</p><div class="av-process-topline"><strong>See the full planning process</strong><a href="/how-it-works/">↗</a></div><div class="av-process-steps"><div class="av-process-step"><div class="av-process-icon">◎</div><div><h3>Define the Group</h3><p>Who is likely to travel, what connects them, and what constraints matter?</p></div></div><div class="av-process-step"><div class="av-process-icon">⌖</div><div><h3>Shape the Trip</h3><p>Activity, destination, pace, comfort, support, timing, and approximate budget.</p></div></div><div class="av-process-step"><div class="av-process-icon">▣</div><div><h3>Build the Travel System</h3><p>Accommodation, transport, operators, activities, rooming, and dependencies.</p></div></div><div class="av-process-step"><div class="av-process-icon">▤</div><div><h3>Prepare Travelers</h3><p>Documents, readiness, payment milestones, final information, and departure support.</p></div></div></div></div></div></section>
</BaseLayout>
