---
import BaseLayout from '../layouts/BaseLayout.astro';
import { images } from '../data/assets';
import { coreExperienceCards, trustSignals, audienceLinks } from '../data/site';
import { articles } from '../data/articles';
const featured=articles.slice(0,3);
const gallery=[
  ['Trekking & mountain travel',images.trekking],['Dive & marine travel',images.water],['Wildlife & nature',images.wildlife],
  ['Culture & cities',images.culture],['Coast & islands',images.coast],['Active rest',images.lake]
];
---
<BaseLayout title="Talon Expeditions | Private Group, Active & Experience-Led Travel" description="Talon Expeditions plans private group travel, active journeys, learn-to trips, trekking, cultural travel, cruises, and experience-led journeys worldwide." image={images.hero} schema={{'@type':'TravelAgency',name:'Talon Expeditions',url:Astro.site?.toString(),areaServed:'Worldwide'}}>
  <section class="av-home-hero" style={`background-image:url('${images.hero}')`}>
    <div class="av-home-hero-inner">
      <div class="av-home-intro"><p class="eyebrow">Private group travel · Worldwide</p><h1>One Journey at a Time</h1><p>Travel built around the people going, the experience they want, and the support needed to make the whole trip work.</p><div class="av-home-review"><div class="av-avatar-stack"><span style={`background-image:url('${images.group}')`}></span><span style={`background-image:url('${images.coastalTraveler}')`}></span><span style={`background-image:url('${images.galleryTravel}')`}></span></div><span>Private groups, clubs, communities & teams</span></div></div>
      <div class="av-home-wordwall"><span>Travel</span><span>Adventure Trip</span><span>Destinations</span><span>Tour</span><span>World Explore</span><span>Trip Planner</span><span>Learn-To Travel</span><span class="av-big-world">Explore The World<br/>with Talon</span></div>
    </div>
  </section>

  <div class="av-home-booking-wrap"><div class="av-home-booking-grid">
    <form class="av-home-booking-card" action="/plan-a-trip/" method="get"><p class="eyebrow">Start with the idea</p><h2>What are you trying to plan?</h2><div class="planner-grid"><div class="field"><label for="home-group">Group type</label><select id="home-group" name="group"><option>Club or community</option><option>Private group / friends</option><option>Business or team</option><option>Wellness community</option><option>Individual traveler</option></select></div><div class="field"><label for="home-style">Trip style</label><select id="home-style" name="style"><option>Active / trekking</option><option>Learn-to / skill based</option><option>Culture / cruise</option><option>Wildlife / nature</option><option>Not sure yet</option></select></div><button class="button" type="submit">Start Planning</button></div></form>
    <div class="av-home-supports"><div class="av-home-support"><h3>Organizer Support</h3><p>Clearer planning, participant information, preparation, and fewer disconnected moving parts.</p></div><div class="av-home-support"><h3>Easy to Start</h3><p>You do not need a finished itinerary. A group, destination, activity, or season is enough.</p></div></div>
  </div></div>

  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Destinations</p><h2>Explore Popular Travel Styles</h2></div><p>Start with the kind of journey your group wants. The destination, route, pace, and support model can be shaped around it.</p><a class="button button-small" href="/experiences/">Browse all Experiences</a></div><div class="av-destination-grid">{coreExperienceCards.slice(0,3).map((item,index)=><a class="av-destination-card" href={item.href} style={`background-image:url('${item.image}')`}><div class="av-destination-card-top"><span>{item.eyebrow}</span><span class="av-card-arrow">↗</span></div><h3>{item.title}</h3><p>{item.copy}</p><div class="av-destination-tags"><span>Private groups</span><span>Worldwide</span><span>{index===0?'Custom':index===1?'Skill-based':'Active'}</span></div></a>)}</div></div></section>

  <section class="av-category-stage"><div class="shell av-category-grid"><div><p class="eyebrow">Tour Categories</p><h2 class="section-title">Choose Your Travel Style</h2><p class="av-category-copy">Find the experience that best matches the reason your group wants to travel.</p><ul class="av-category-menu"><li>Private Groups</li><li>Learn-To Travel</li><li>Trekking & Active</li><li>Culture & Cruise</li><li>Wildlife & Nature</li><li>Active Rest</li></ul></div><div class="av-category-visual" style={`background-image:url('${images.trekking}')`}><div class="av-category-caption"><h3>Travel with a reason to go.</h3><p>Move through landscapes, learn something new, spend time with your community, or simply experience a place more intentionally.</p><a class="button button-small" href="/experiences/">Explore Experiences</a></div></div></div></section>

  <section class="section"><div class="shell"><div class="av-values-intro"><div><p class="eyebrow">Why Choose Talon</p><h2 class="section-title">We craft travel around the group, not around generic inventory.</h2></div><p>Group travel works better when the people, purpose, activity level, comfort, and organizer workload are clear before the itinerary hardens.</p></div><div class="av-values-grid">{trustSignals.map((item,index)=><div class="av-value"><div class="av-value-badge"><h3>{item.title}</h3><span>0{index+1}</span></div><p>{item.copy}</p></div>)}</div></div></section>

  <section class="section-tight"><div class="shell"><div class="av-gallery-title"><p class="eyebrow">Experience Gallery</p><h2 class="section-title">Travel that gives the group something to remember doing together.</h2></div><div class="av-gallery-grid">{gallery.map(([label,image])=><a href="/gallery/" class="av-gallery-tile" style={`background-image:url('${image}')`}><span>{label}</span></a>)}</div></div></section>

  <section class="av-proof-band" style={`background-image:url('${images.road}')`}><div class="shell"><div class="av-proof-head"><p class="eyebrow">How we work</p><h2>Professional behind the scenes. Personal to the group.</h2></div><div class="av-proof-grid"><div class="av-proof-card"><div class="stars">★★★★★</div><h3>Clear scope</h3><p>Travelers should understand what is planned, what is included, what requires local specialists, and what remains their responsibility.</p><small>Planning clarity</small></div><div class="av-proof-card"><div class="stars">★★★★★</div><h3>Realistic preparation</h3><p>Activity, equipment, documents, fitness, rooming, and arrival requirements are easier to solve before they become last-minute problems.</p><small>Traveler readiness</small></div><div class="av-proof-card"><div class="stars">★★★★★</div><h3>Group-first decisions</h3><p>The trip is shaped around the actual people rather than an imaginary average traveler or a fixed catalog departure.</p><small>Organizer support</small></div></div></div></section>

  <section class="av-process"><div class="shell av-process-grid"><div class="av-process-visual" style={`background-image:url('${images.planning}')`}><div class="av-process-callout"><h3>Start Your Journey With Us</h3><p>Bring the group, the destination, the activity, or simply the idea. We will help make the next decisions clearer.</p></div></div><div class="av-process-copy"><p class="eyebrow">How it Works</p><h2>Plan your Trip in Just a Few Clear Steps</h2><p class="av-process-lead">The process begins broad and becomes specific as the group, route, suppliers, and traveler requirements come into focus.</p><div class="av-process-topline"><strong>Make a Planning Appointment</strong><a href="/plan-a-trip/">↗</a></div><div class="av-process-steps"><div class="av-process-step"><div class="av-process-icon">⌖</div><div><h3>Define the Trip</h3><p>Who is traveling, why they are going, what dates, activity, comfort, and budget constraints matter.</p></div></div><div class="av-process-step"><div class="av-process-icon">▣</div><div><h3>Shape the Plan</h3><p>Choose the destination, route, accommodation, transport, local operators, and support model.</p></div></div><div class="av-process-step"><div class="av-process-icon">▤</div><div><h3>Prepare to Launch</h3><p>Turn the plan into clear information people can understand, evaluate, and commit to.</p></div></div><div class="av-process-step"><div class="av-process-icon">☀</div><div><h3>Get Ready & Go</h3><p>Resolve rooming, arrivals, documents, equipment, prerequisites, and final travel information.</p></div></div></div></div></div><div class="av-partner-strip"><span>Private Groups</span><span>Clubs</span><span>Communities</span><span>Teams</span><span>Worldwide Travel</span></div></section>

  <section class="av-newsletter-hero" style={`background-image:url('${images.planning}')`}><div class="shell av-newsletter-grid"><div class="av-newsletter-card"><p class="eyebrow">Join Our Travel Circle</p><h2>Planning ideas, trip formats, and new departures.</h2><p>Follow the planning library now. Email updates can be added when the subscription system is live.</p><a class="button button-small" href="/resources/">Browse Travel Guides</a></div><div class="av-stat-row"><div class="av-stat"><strong>Private</strong><span>Group-first planning</span></div><div class="av-stat"><strong>Global</strong><span>Worldwide destinations</span></div><div class="av-stat"><strong>Supported</strong><span>From idea to departure</span></div></div></div></section>

  <section class="section"><div class="shell"><div class="av-blog-heading"><p class="eyebrow">Travel Tips & Stories</p><h2>Latest Planning Guides & Travel Inspiration</h2></div><div class="av-blog-grid">{featured.map(article=><a class="av-blog-card" href={`/guides/${article.slug}/`}><div class="av-blog-image" style={`background-image:url('${article.image}')`}></div><div class="av-blog-body"><span class="av-blog-meta">{article.category}</span><h3>{article.title}</h3><p>{article.description}</p><span class="text-arrow">Read More →</span></div></a>)}</div></div></section>
</BaseLayout>
