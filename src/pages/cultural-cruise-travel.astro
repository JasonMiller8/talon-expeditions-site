---
import BaseLayout from '../layouts/BaseLayout.astro';
import { images } from '../data/assets';
const formats=[
  {title:'Hosted Cultural Journeys',copy:'Food, heritage, neighborhoods, local context, and shared discovery with enough room to breathe.',image:images.marrakech,tags:['Culture','Hosted']},
  {title:'River & Coastal Cruises',copy:'Use the ship or vessel as the moving base while the experience changes from stop to stop.',image:images.boat,tags:['Cruise','Coastal']},
  {title:'City & Region Discovery',copy:'Curated urban and regional travel that balances guided experiences with genuinely useful free time.',image:images.culture,tags:['Cities','Discovery']},
  {title:'Island & Coast',copy:'Scenic, social and lightly active journeys built around coastlines, islands, water, and slower movement.',image:images.coast,tags:['Islands','Coast']},
  {title:'Comfort-Forward Active',copy:'Stay active without making physical challenge the whole identity of the trip.',image:images.lake,tags:['Active rest','Comfort']},
  {title:'Social & Affinity Groups',copy:'Hosted travel designed around the people and shared interest that brought the group together.',image:images.city,tags:['Community','Hosted']}
];
---
<BaseLayout title="Cultural & Cruise Group Travel | Talon Expeditions" description="Curated cultural, coastal and cruise group travel with the support of a group travel partner." image={images.culture}>
  <section class="page-hero" style={`background-image:url('${images.culture}')`}><div class="shell"><p class="eyebrow">Culture & Cruise</p><h1 class="section-title">Shared journeys with time to discover, connect, and actually enjoy being there.</h1><p>Culture-led itineraries, scenic and coastal travel, and hosted cruise experiences for groups that want structure without feeling over-programmed.</p></div></section>

  <section class="specialty-intro"><div class="shell"><div class="specialty-heading"><div><p class="eyebrow">Ways to travel</p><h2 class="section-title">Experience-led does not have to mean high-intensity.</h2></div><p class="section-copy">Distinct cultural and cruise formats give groups a clearer way to choose pace and purpose than a generic destination catalog.</p></div><div class="destination-grid">{formats.map((item)=><a class="destination-card" href="/contact/" style={`background-image:url('${item.image}')`}><div class="destination-content"><span class="tagline">Group format</span><h3>{item.title}</h3><p>{item.copy}</p><div class="mini-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></div></a>)}</div></div></section>

  <section class="section"><div class="shell split-copy-image"><div><p class="eyebrow">The pacing matters</p><h2 class="section-title">Enough structure to make the trip rich. Enough space to make it feel like travel.</h2><p class="section-copy">Cultural journeys can become exhausting when every hour is scheduled. Talon can combine anchor experiences, practical coordination, optional activity, and free time so the group is supported without being marched through the destination.</p><div class="chip-row"><span class="chip">Culture & heritage</span><span class="chip">Food & local life</span><span class="chip">Cruise & coast</span><span class="chip">Light activity</span><span class="chip">Hosted social travel</span><span class="chip">Comfort-forward pacing</span></div><a class="button" href="/contact/">Shape a Cultural Journey</a></div><div class="split-image" style={`background-image:url('${images.city}')`}></div></div></section>

  <section class="section tabbed-feature"><div class="shell tabbed-grid"><div><p class="eyebrow">Choose your rhythm</p><h2 class="section-title">Not every day needs the same energy.</h2><ul class="category-menu"><li class="active">Guided discovery</li><li>Independent time</li><li>Hosted meals & social time</li><li>Light active experiences</li><li>Scenic travel days</li><li>Rest without guilt</li></ul></div><div class="category-feature" style={`background-image:url('${images.paddle}')`}><div class="feature-note"><h3>A trip can be active and comfortable at the same time.</h3><p>The goal is a journey that gives the group reasons to engage without making every traveler prove something every day.</p></div></div></div></section>

  <section class="section"><div class="shell process-donor"><div class="process-visual" style={`background-image:url('${images.marrakech}')`}><div class="process-callout"><h3>Anchor the journey.</h3><p>Choose the experiences worth organizing around, then let the itinerary breathe between them.</p></div></div><div><p class="eyebrow">How we shape it</p><h2 class="section-title">Build from the shared interest outward.</h2><div class="process-list"><div class="process-item"><b>Define the group</b><p>Who is traveling together and what brought them together?</p></div><div class="process-item"><b>Choose anchor experiences</b><p>The culture, cruise, region, food, event, or shared interest that makes the trip worth taking.</p></div><div class="process-item"><b>Set the pace</b><p>Balance guided time, movement, social time, free time, and recovery.</p></div><div class="process-item"><b>Coordinate the practical pieces</b><p>Lodging, transport, reservations, operators, timing, and traveler information.</p></div></div></div></div></section>

  <section class="specialty-cta"><div class="shell"><h2>Want a group trip that feels organized without feeling programmed?</h2><a class="button button-secondary" href="/contact/">Plan With Talon</a></div></section>
</BaseLayout>
