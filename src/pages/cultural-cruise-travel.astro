---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { culturalPages } from '../data/landing';
import { images } from '../data/assets';
const breadcrumbs=[{label:'Cultural & Cruise Travel',href:'/cultural-cruise-travel/'}];
const cards=[
 ...culturalPages.map((page)=>({title:page.title,image:page.hero,copy:page.description,href:`/cultural-cruise-travel/${page.slug}/`,tags:['Culture','Hosted','Groups']})),
 {title:'City & Region Discovery',image:images.culture,copy:'Curated urban and regional travel that balances guided experiences, local food, independent time, and realistic group movement.',href:'/plan-a-trip/',tags:['Cities','Discovery','Flexible']},
 {title:'Active Cultural Travel',image:images.paddle,copy:'Walk, hike, paddle, cycle, or move through a region while keeping culture and place at the center of the itinerary.',href:'/trekking-active-travel/',tags:['Active rest','Culture','Movement']},
 {title:'Social & Affinity Travel',image:images.group,copy:'Hosted travel for communities whose members already share an interest, organization, identity, or reason to spend time together.',href:'/group-travel/social-affinity/',tags:['Community','Hosted','Private']},
 {title:'Coast & Island Journeys',image:images.coast,copy:'Scenic travel combining coastlines, islands, food, culture, light activity, and comfortable group pacing.',href:'/plan-a-trip/',tags:['Coast','Culture','Comfort']}
];
---
<BaseLayout title="Cultural & Cruise Group Travel | Talon Expeditions" description="Private cultural group travel and hosted cruise planning for clubs, communities, social groups, businesses, and private travelers, with worldwide coordination and flexible pacing." image={images.culture} breadcrumbs={breadcrumbs}>
  <section class="av-inner-hero" style={`background-image:url('${images.culture}')`}><div class="shell"><h1>Cultural & Cruise Travel</h1><Breadcrumbs items={breadcrumbs}/></div></section>
  <section class="section"><div class="shell"><div class="av-section-heading"><div><p class="eyebrow">Culture, Coastlines & Connection</p><h2>Shared Journeys With Time to Discover and Actually Enjoy Being There</h2></div><p>Culture-led itineraries, hosted cruise groups, scenic travel, and comfort-forward journeys for people who want useful structure without turning the trip into a schedule they have to survive.</p><a class="button button-small" href="/plan-a-trip/">Plan a Cultural Trip</a></div><div class="av-destination-grid">{cards.map((item)=><a class="av-destination-card" href={item.href} style={`background-image:url('${item.image}')`}><div class="av-destination-card-top"><span>Hosted travel</span><span class="av-card-arrow">↗</span></div><h3>{item.title}</h3><p>{item.copy}</p><div class="av-destination-tags">{item.tags.map((tag)=><span>{tag}</span>)}</div></a>)}</div></div></section>
  <section class="av-category-stage"><div class="shell av-category-grid"><div><p class="eyebrow">Choose Your Rhythm</p><h2 class="section-title">Not Every Day Needs the Same Energy</h2><p class="av-category-copy">The best cultural itineraries usually protect a few anchor experiences and leave enough room for the group to absorb the destination.</p><ul class="av-category-menu"><li>Guided Discovery</li><li>Independent Time</li><li>Hosted Meals</li><li>Light Activity</li><li>Scenic Travel</li><li>Real Rest</li></ul></div><div class="av-category-visual" style={`background-image:url('${images.marrakech}')`}><div class="av-category-caption"><h3>Enough structure to make the trip rich. Enough space to make it feel like travel.</h3><p>Travel time, meals, walking, hotel changes, jet lag, and the fact that groups move more slowly than individuals all belong in the itinerary.</p></div></div></div></section>
  <section class="av-proof-band" style={`background-image:url('${images.boat}')`}><div class="shell"><div class="av-proof-head"><p class="eyebrow">Hosted Cruise Groups</p><h2>The ship can handle the route. The group still needs a plan.</h2></div><div class="av-proof-grid"><div class="av-proof-card"><h3>Before the Cruise</h3><p>Cabin and booking structure, arrival timing, hotel nights, transfers, documents, and a clear embarkation plan.</p><small>Arrival coordination</small></div><div class="av-proof-card"><h3>During the Cruise</h3><p>Selected shared meals or experiences, optional shore time, group communication, and enough independence to enjoy the ship.</p><small>Hosted travel</small></div><div class="av-proof-card"><h3>After the Cruise</h3><p>Disembarkation, onward flights, extra nights, transfers, or a cultural extension that adds depth beyond the sailing.</p><small>Extensions</small></div></div></div></section>
  <section class="av-process"><div class="shell av-process-grid"><div class="av-process-visual" style={`background-image:url('${images.city}')`}><div class="av-process-callout"><h3>Anchor the Journey</h3><p>Choose the experiences worth organizing around, then let the itinerary breathe between them.</p></div></div><div class="av-process-copy"><p class="eyebrow">How We Shape It</p><h2>Build From the Shared Interest Outward</h2><p class="av-process-lead">A cultural or hosted trip is easier to design when the organizer can explain what the group wants beyond seeing as much as possible.</p><div class="av-process-topline"><strong>Explore cultural planning</strong><a href="/guides/how-to-plan-cultural-group-travel-without-over-scheduling/">↗</a></div><div class="av-process-steps"><div class="av-process-step"><div class="av-process-icon">◎</div><div><h3>Define the Group</h3><p>Who is traveling, what connects them, and what pace and comfort matter?</p></div></div><div class="av-process-step"><div class="av-process-icon">⌖</div><div><h3>Choose Anchor Experiences</h3><p>Identify the culture, food, history, cruise, event, or region that makes the trip worth taking.</p></div></div><div class="av-process-step"><div class="av-process-icon">☀</div><div><h3>Set the Pace</h3><p>Balance guided time, movement, social time, independence, meals, and recovery.</p></div></div><div class="av-process-step"><div class="av-process-icon">▣</div><div><h3>Coordinate the Details</h3><p>Connect lodging, transport, reservations, tickets, rooming, and traveler information.</p></div></div></div></div></div></section>
</BaseLayout>
