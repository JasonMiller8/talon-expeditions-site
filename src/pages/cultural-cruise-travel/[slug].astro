---
import LandingPage from '../../components/LandingPage.astro';
import { culturalPages } from '../../data/landing';
export function getStaticPaths(){ return culturalPages.map((page)=>({params:{slug:page.slug},props:{page}})); }
const { page } = Astro.props;
---
<LandingPage page={page} parentLabel="Cultural & Cruise Travel" parentHref="/cultural-cruise-travel/" />
